# Copia este archivo como .env y llena los valores. Nunca subas .env a git.

# Lo inventas tu (una cadena larga y dificil de adivinar). Es el mismo que escribes en Meta al configurar el webhook.
# Obligatorio: el servidor no arranca sin el.
VERIFY_TOKEN=

# Token de acceso (empieza con EAA). Usa el del usuario de sistema, no el temporal de 24 h.
WHATSAPP_TOKEN=

# Phone Number ID del numero de ToyLoco (+52 1 662 142 9049). No es el numero telefonico.
PHONE_NUMBER_ID=

# App Secret de la app Responder (Configuracion > Basico). Valida que el mensaje venga de Meta.
# Obligatorio cuando NODE_ENV=production.
APP_SECRET=

# Puerto local (Railway lo define solo)
PORT=3000

API_VERSION=v26.0

# Solo en produccion: exige APP_SECRET y firma valida
# NODE_ENV=production

# Pruebas: 1 = no llama a Meta, solo registra lo que enviaria
# DRY_RUN=1

# 1 = registrar texto de los mensajes de clientes (por defecto no se registra, por privacidad)
# LOG_CONTENIDO=1

# URL del CSV publicado de la pestana BOT (Archivo > Compartir > Publicar en la web > solo la pestana BOT, CSV).
# Sin ella, en desarrollo se usa inventario-demo.json; en produccion el bot avisa que no puede consultar el inventario.
# CATALOGO_URL=

# Minutos que se guarda el catalogo en memoria antes de volver a leer la hoja (segundos, por defecto 300)
# CATALOGO_TTL_SEG=300

# Aviso al dueno por WhatsApp (plantilla aprobada, categoria Utilidad, 3 variables: tipo, producto, cliente)
# Sin DUENO_WHATSAPP el bot funciona igual, pero nadie se entera de "Me interesa" / "Hablar con alguien".
# DUENO_WHATSAPP=521XXXXXXXXXX
# PLANTILLA_AVISO=aviso_cliente
# PLANTILLA_IDIOMA=es_MX

# Nombre del negocio en los mensajes (por defecto ToyLoco)
# NEGOCIO_NOMBRE=ToyLoco
